{
  "name": "pi-custom-packages",
  "version": "0.1.0",
  "description": "Packages for the pi coding agent: elapsed-time status, session guards, Herdr integration, Windows/WSL tools, a low-glare light terminal, and ChatGPT subscription account switching.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-coding-agent",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blue-B/pi-custom-packages.git"
  },
  "homepage": "https://github.com/Blue-B/pi-custom-packages#readme",
  "bugs": {
    "url": "https://github.com/Blue-B/pi-custom-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "./packages/pi-bash-watchdog/extensions/bash-watchdog/index.ts",
      "./packages/pi-elapsed-timer/extensions/elapsed-timer/index.ts",
      "./packages/pi-openai-accounts/extensions/openai-accounts/index.ts",
      "./packages/pi-gpt-img/extensions/gpt-img/index.ts",
      "./packages/pi-herdr-ask-blocked/extensions/herdr-ask-blocked/index.ts",
      "./packages/pi-winshot/extensions/winshot/index.ts"
    ],
    "skills": [
      "./packages/pi-winshot/skills/winshot",
      "./packages/pi-light-eyes/skills/light-eyes"
    ],
    "themes": [
      "./packages/pi-light-eyes/themes/chatgpt-light.json"
    ]
  }
}
